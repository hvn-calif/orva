# avoid trailing `/` because these are symlinks
/bazel-*
/target
bazelisk
MODULE.bazel.lock
build/
rust/target/


# Added by cargo
#
# already existing elements were commented out

#/target

# ANTLR (pulled in by FuzzTest) writes its runtime libraries here during the
# build, into the source tree rather than the build directory.
/dist/

# Local fuzzing run output: logs, corpora and crash reproducers.
/fuzzrun/

# The machine-local redirect of apache-avro to a patched checkout. patches/
# README.md rules out committing a checkout path, and the second Crubit cargo
# invocation drops a [patch] written in rust/Cargo.toml, so it has to live here.
/.cargo/
