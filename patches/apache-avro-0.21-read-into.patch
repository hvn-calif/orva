+    fn test_reader_read_into_reuses_record_and_string_allocations() -> TestResult {
+        let mut reader = Reader::new(ENCODED)?;
+        let mut value = Value::Null;
+
+        assert!(reader.read_into(&mut value)?);
+        let Value::Record(fields) = &value else {
+            panic!("expected record");
+        };
+        let record_ptr = fields.as_ptr();
+        let field_name_ptrs: Vec<_> = fields.iter().map(|(name, _)| name.as_ptr()).collect();
+        let Value::String(string) = &fields[1].1 else {
+            panic!("expected string field");
+        };
+        let string_ptr = string.as_ptr();
+
+        assert!(reader.read_into(&mut value)?);
+        let Value::Record(fields) = &value else {
+            panic!("expected record");
+        };
+        assert_eq!(record_ptr, fields.as_ptr());
+        assert_eq!(
+            field_name_ptrs,
+            fields
+                .iter()
+                .map(|(name, _)| name.as_ptr())
+                .collect::<Vec<_>>()
+        );
+        let Value::String(string) = &fields[1].1 else {
+            panic!("expected string field");
+        };
+        assert_eq!(string_ptr, string.as_ptr());
+        assert_eq!(string, "bar");
+        assert!(!reader.read_into(&mut value)?);
+
+        Ok(())
+    }
