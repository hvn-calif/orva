+/// Decode a `Value` into caller-owned storage.
+///
+/// This is an experimental counterpart to [`decode_internal`] used by
+/// `Reader::read_into`. It reuses allocations for bytes, strings, fixed values,
+/// unions, arrays, and records when the existing value has a compatible shape.
+/// Maps and the allocation-owning logical types currently fall back to
+/// `decode_internal`.
+pub(crate) fn decode_into_internal<R: Read, S: Borrow<Schema>>(
+    schema: &Schema,
+    names: &HashMap<Name, S>,
+    enclosing_namespace: &Namespace,
+    reader: &mut R,
+    value: &mut Value,
+) -> AvroResult<()> {
+    macro_rules! set_scalar {
+        ($variant:path, $decoded:expr) => {{
+            let decoded = $decoded;
+            match value {
+                $variant(current) => *current = decoded,
+                _ => *value = $variant(decoded),
+            }
+        }};
+    }
+
+    match schema {
+        Schema::Null => {
+            if !matches!(value, Value::Null) {
+                *value = Value::Null;
+            }
+        }
+        Schema::Boolean => {
+            let mut buf = [0u8; 1];
+            match reader.read_exact(&mut buf) {
+                Ok(()) => match buf[0] {
+                    0 => set_scalar!(Value::Boolean, false),
+                    1 => set_scalar!(Value::Boolean, true),
+                    byte => return Err(Details::BoolValue(byte).into()),
+                },
+                Err(io_err) if io_err.kind() == ErrorKind::UnexpectedEof => *value = Value::Null,
+                Err(io_err) => return Err(Details::ReadBoolean(io_err).into()),
+            }
+        }
+        Schema::Int => set_scalar!(Value::Int, zag_i32(reader)?),
+        Schema::Date => set_scalar!(Value::Date, zag_i32(reader)?),
+        Schema::TimeMillis => set_scalar!(Value::TimeMillis, zag_i32(reader)?),
+        Schema::Long => set_scalar!(Value::Long, zag_i64(reader)?),
+        Schema::TimeMicros => set_scalar!(Value::TimeMicros, zag_i64(reader)?),
+        Schema::TimestampMillis => set_scalar!(Value::TimestampMillis, zag_i64(reader)?),
+        Schema::TimestampMicros => set_scalar!(Value::TimestampMicros, zag_i64(reader)?),
+        Schema::TimestampNanos => set_scalar!(Value::TimestampNanos, zag_i64(reader)?),
+        Schema::LocalTimestampMillis => {
+            set_scalar!(Value::LocalTimestampMillis, zag_i64(reader)?);
+        }
+        Schema::LocalTimestampMicros => {
+            set_scalar!(Value::LocalTimestampMicros, zag_i64(reader)?);
+        }
+        Schema::LocalTimestampNanos => {
+            set_scalar!(Value::LocalTimestampNanos, zag_i64(reader)?);
+        }
+        Schema::Duration => {
+            let mut buf = [0u8; 12];
+            reader.read_exact(&mut buf).map_err(Details::ReadDuration)?;
+            set_scalar!(Value::Duration, Duration::from(buf));
+        }
+        Schema::Float => {
+            let mut buf = [0u8; std::mem::size_of::<f32>()];
+            reader.read_exact(&mut buf).map_err(Details::ReadFloat)?;
+            set_scalar!(Value::Float, f32::from_le_bytes(buf));
+        }
+        Schema::Double => {
+            let mut buf = [0u8; std::mem::size_of::<f64>()];
+            reader.read_exact(&mut buf).map_err(Details::ReadDouble)?;
+            set_scalar!(Value::Double, f64::from_le_bytes(buf));
+        }
+        Schema::Bytes => {
+            let len = decode_len(reader)?;
+            if !matches!(value, Value::Bytes(_)) {
+                *value = Value::Bytes(Vec::new());
+            }
+            let Value::Bytes(buf) = value else {
+                unreachable!()
+            };
+            buf.resize(len, 0);
+            reader.read_exact(buf).map_err(Details::ReadBytes)?;
+        }
+        Schema::String => {
+            let len = decode_len(reader)?;
+            let old = std::mem::replace(value, Value::Null);
+            let mut buf = match old {
+                Value::String(string) => string.into_bytes(),
+                _ => Vec::new(),
+            };
+            buf.resize(len, 0);
+            match reader.read_exact(&mut buf) {
+                Ok(()) => {
+                    *value = Value::String(String::from_utf8(buf).map_err(Details::ConvertToUtf8)?);
+                }
+                Err(io_err) if io_err.kind() == ErrorKind::UnexpectedEof => {
+                    *value = Value::Null;
+                }
+                Err(io_err) => return Err(Details::ReadString(io_err).into()),
+            }
+        }
+        Schema::Fixed(FixedSchema { size, .. }) => {
+            if !matches!(value, Value::Fixed(_, _)) {
+                *value = Value::Fixed(*size, Vec::new());
+            }
+            let Value::Fixed(current_size, buf) = value else {
+                unreachable!()
+            };
+            *current_size = *size;
+            buf.resize(*size, 0);
+            reader
+                .read_exact(buf)
+                .map_err(|e| Details::ReadFixed(e, *size))?;
+        }
+        Schema::Array(inner) => {
+            if !matches!(value, Value::Array(_)) {
+                *value = Value::Array(Vec::new());
+            }
+            let Value::Array(items) = value else {
+                unreachable!()
+            };
+            let mut decoded = 0usize;
+            loop {
+                let len = decode_seq_len(reader)?;
+                if len == 0 {
+                    break;
+                }
+
+                let total = decoded.checked_add(len).ok_or(Details::IntegerOverflow)?;
+                let allocation_bytes = total
+                    .checked_mul(std::mem::size_of::<Value>())
+                    .ok_or(Details::IntegerOverflow)?;
+                safe_len(allocation_bytes)?;
+                if total > items.len() {
+                    items.reserve_exact(total - items.len());
+                }
+                for _ in 0..len {
+                    if decoded == items.len() {
+                        items.push(Value::Null);
+                    }
+                    decode_into_internal(
+                        &inner.items,
+                        names,
+                        enclosing_namespace,
+                        reader,
+                        &mut items[decoded],
+                    )?;
+                    decoded += 1;
+                }
+            }
+            items.truncate(decoded);
+        }
+        Schema::Map(_) => {
+            // A HashMap does not expose reusable ownership of stale key/value
+            // entries while it is being rebuilt from wire-order keys. A
+            // production implementation needs decoder-owned key/value pools.
+            *value = decode_internal(schema, names, enclosing_namespace, reader)?;
+        }
+        Schema::Union(inner) => {
+            let index = match zag_i64(reader).map_err(Error::into_details) {
+                Ok(index) => index,
+                Err(Details::ReadVariableIntegerBytes(io_err))
+                    if io_err.kind() == ErrorKind::UnexpectedEof =>
+                {
+                    if !matches!(value, Value::Union(_, _)) {
+                        *value = Value::Union(0, Box::new(Value::Null));
+                    }
+                    let Value::Union(index, inner_value) = value else {
+                        unreachable!()
+                    };
+                    *index = 0;
+                    **inner_value = Value::Null;
+                    return Ok(());
+                }
+                Err(details) => return Err(Error::new(details)),
+            };
+            let variants = inner.variants();
+            let index_usize =
+                usize::try_from(index).map_err(|e| Details::ConvertI64ToUsize(e, index))?;
+            let variant = variants.get(index_usize).ok_or(Details::GetUnionVariant {
+                index,
+                num_variants: variants.len(),
+            })?;
+
+            if !matches!(value, Value::Union(_, _)) {
+                *value = Value::Union(index as u32, Box::new(Value::Null));
+            }
+            let Value::Union(current_index, inner_value) = value else {
+                unreachable!()
+            };
+            *current_index = index as u32;
+            decode_into_internal(variant, names, enclosing_namespace, reader, inner_value)?;
+        }
+        Schema::Record(RecordSchema { name, fields, .. }) => {
+            let reusable = matches!(
+                value,
+                Value::Record(items)
+                    if items.len() == fields.len()
+                        && items
+                            .iter()
+                            .zip(fields)
+                            .all(|((actual, _), expected)| actual == &expected.name)
+            );
+            if !reusable {
+                let mut items = Vec::with_capacity(fields.len());
+                items.extend(fields.iter().map(|field| (field.name.clone(), Value::Null)));
+                *value = Value::Record(items);
+            }
+
+            let fully_qualified_name = name.fully_qualified_name(enclosing_namespace);
+            let Value::Record(items) = value else {
+                unreachable!()
+            };
+            for ((_, item), field) in items.iter_mut().zip(fields) {
+                decode_into_internal(
+                    &field.schema,
+                    names,
+                    &fully_qualified_name.namespace,
+                    reader,
+                    item,
+                )?;
+            }
+        }
+        Schema::Enum(EnumSchema { symbols, .. }) => {
+            let raw_index = zag_i32(reader)?;
+            let index =
+                usize::try_from(raw_index).map_err(|e| Details::ConvertI32ToUsize(e, raw_index))?;
+            let symbol = symbols.get(index).ok_or(Details::GetEnumValue {
+                index,
+                nsymbols: symbols.len(),
+            })?;
+            match value {
+                Value::Enum(current_index, current_symbol) => {
+                    *current_index = raw_index as u32;
+                    current_symbol.clone_from(symbol);
+                }
+                _ => *value = Value::Enum(raw_index as u32, symbol.clone()),
+            }
+        }
+        Schema::Ref { name } => {
+            let fully_qualified_name = name.fully_qualified_name(enclosing_namespace);
+            if let Some(resolved) = names.get(&fully_qualified_name) {
+                decode_into_internal(
+                    resolved.borrow(),
+                    names,
+                    &fully_qualified_name.namespace,
+                    reader,
+                    value,
+                )?;
+            } else {
+                return Err(Details::SchemaResolutionError(fully_qualified_name).into());
+            }
+        }
+        // Decimal, BigDecimal, and UUID own allocation-bearing third-party
+        // representations without public in-place decode APIs. Keep their
+        // existing, fully tested decoding behavior in this prototype.
+        Schema::Decimal(_) | Schema::BigDecimal | Schema::Uuid => {
+            *value = decode_internal(schema, names, enclosing_namespace, reader)?;
+        }
+    }
+    Ok(())
+}
+
