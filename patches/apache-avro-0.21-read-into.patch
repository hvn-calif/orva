+    fn read_next_into(
+        &mut self,
+        read_schema: Option<&Schema>,
+        value: &mut Value,
+    ) -> AvroResult<bool> {
+        if self.is_empty() {
+            self.read_block_next()?;
+            if self.is_empty() {
+                return Ok(false);
+            }
+        }
+
+        let mut block_bytes = &self.buf[self.buf_idx..];
+        let b_original = block_bytes.len();
+
+        if let Some(schema) = read_schema {
+            // Schema resolution currently consumes a Value and can change its
+            // shape. Preserve existing behavior, but do not claim allocation
+            // reuse for this path.
+            *value = decode_internal(
+                &self.writer_schema,
+                &self.names_refs,
+                &None,
+                &mut block_bytes,
+            )?
+            .resolve(schema)?;
+        } else {
+            decode_into_internal(
+                &self.writer_schema,
+                &self.names_refs,
+                &None,
+                &mut block_bytes,
+                value,
+            )?;
+        }
+
+        if b_original != 0 && b_original == block_bytes.len() {
+            return Err(Details::ReadBlock.into());
+        }
+        self.buf_idx += b_original - block_bytes.len();
+        self.message_count -= 1;
+        Ok(true)
+    }
