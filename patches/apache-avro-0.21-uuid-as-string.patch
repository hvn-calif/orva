+
+//! The accepting side of `util::set_uuid_as_string`.
+//!
+//! The setting is set-once per process, so these live in their own test binary
+//! rather than beside the parsing cases in `src/decode.rs` and `src/types.rs`.
+//! This follows `tests/serde_human_readable_true.rs`.
+
+use apache_avro::{Schema, from_avro_datum, to_avro_datum, types::Value, util::set_uuid_as_string};
+use apache_avro_test_helper::TestResult;
+
+/// Every test in this binary needs the setting on. Calling it more than once is
+/// harmless (first call wins), and the return value is the setting in effect,
+/// which is what a caller who requires it should be checking.
+fn enable() {
+    assert!(
+        set_uuid_as_string(true),
+        "the setting must be in effect for this test binary"
+    );
+}
+
+/// One Avro `string`: zigzag length prefix, then the payload. Only single-byte
+/// prefixes, which covers every payload below.
+fn string_datum(payload: &[u8]) -> Vec<u8> {
+    assert!(payload.len() < 64, "length would need a longer varint");
+    let mut out = vec![(payload.len() as u8) << 1];
+    out.extend_from_slice(payload);
+    out
+}
+
+/// Decodes `payload` under a `uuid` schema and re-encodes what came back,
+/// returning both so a test can assert the value and the round trip at once.
+fn decode_and_reencode(
+    payload: &[u8],
+) -> anyhow::Result<(Value, Vec<u8>), apache_avro_test_helper::TestError> {
+    let schema = Schema::Uuid;
+    let datum = string_datum(payload);
+    let value = from_avro_datum(&schema, &mut datum.as_slice(), None)?;
+    let reencoded = to_avro_datum(&schema, value.clone())?;
+    Ok((value, reencoded))
+}
+
+/// The canonical form is unchanged by the setting; it is the forms that are not
+/// canonical which the parsing path rewrites.
+#[test]
+fn canonical_uuid_is_unchanged() -> TestResult {
+    enable();
+    let text = "6ba7b810-9dad-11d1-80b4-00c04fd430c8";
+    let (value, reencoded) = decode_and_reencode(text.as_bytes())?;
+    assert_eq!(value, Value::String(text.to_string()));
+    assert_eq!(reencoded, string_datum(text.as_bytes()));
+    Ok(())
+}
+
+/// The reason the setting exists. Each of these parses as a uuid and would be
+/// written back in canonical hyphenated lowercase, changing the bytes; read as
+/// a string they survive.
+#[test]
+fn non_canonical_spellings_survive() -> TestResult {
+    enable();
+    for text in [
+        "6BA7B810-9DAD-11D1-80B4-00C04FD430C8",
+        "6ba7b810-9DAD-11d1-80B4-00c04fd430c8",
+        "urn:uuid:6ba7b810-9dad-11d1-80b4-00c04fd430c8",
+        "{6ba7b810-9dad-11d1-80b4-00c04fd430c8}",
+        "6ba7b8109dad11d180b400c04fd430c8",
+    ] {
+        let (value, reencoded) = decode_and_reencode(text.as_bytes())?;
+        assert_eq!(value, Value::String(text.to_string()), "value for {text}");
+        assert_eq!(reencoded, string_datum(text.as_bytes()), "bytes for {text}");
+    }
+    Ok(())
+}
+
+/// Without the setting a 16-byte `uuid` is taken as a raw `Uuid` and comes back
+/// as 36 characters of hex, so an ordinary 16-character string is silently
+/// rewritten. Length must not decide how the field is interpreted.
+#[test]
+fn sixteen_byte_string_is_not_reinterpreted_as_raw_bytes() -> TestResult {
+    enable();
+    let text = "  St9exception  ";
+    assert_eq!(text.len(), 16, "the case only bites at exactly 16 bytes");
+    let (value, reencoded) = decode_and_reencode(text.as_bytes())?;
+    assert_eq!(value, Value::String(text.to_string()));
+    assert_eq!(reencoded, string_datum(text.as_bytes()));
+    Ok(())
+}
+
+/// Text that is not a uuid at all is readable rather than an error, which is
+/// what makes data written by an implementation that never validated readable.
+#[test]
+fn malformed_uuid_text_is_readable() -> TestResult {
+    enable();
+    for text in ["not-a-uuid", ""] {
+        let (value, reencoded) = decode_and_reencode(text.as_bytes())?;
+        assert_eq!(value, Value::String(text.to_string()), "value for {text:?}");
+        assert_eq!(
+            reencoded,
+            string_datum(text.as_bytes()),
+            "bytes for {text:?}"
+        );
+    }
+    Ok(())
+}
+
+/// This setting alone does not accept non-UTF-8: that is
+/// `set_non_utf8_string_as_bytes`, and the two are independent. Asserted so the
+/// split between them stays deliberate rather than incidental.
+#[test]
+fn non_utf8_still_fails_without_the_other_setting() {
+    enable();
+    let payload = [0xffu8, 0xfe, 0xfd];
+    let datum = string_datum(&payload);
+    assert!(
+        from_avro_datum(&Schema::Uuid, &mut datum.as_slice(), None).is_err(),
+        "non-UTF-8 needs set_non_utf8_string_as_bytes, which this binary leaves off"
+    );
+}
+
+/// A `uuid` read as a string has to satisfy the schema it was read from, or a
+/// decoded datum could not be handed back to the writer that produced it.
+#[test]
+fn string_validates_and_resolves_against_a_uuid_schema() -> TestResult {
+    enable();
+    let text = "urn:uuid:6ba7b810-9dad-11d1-80b4-00c04fd430c8";
+    let value = Value::String(text.to_string());
+    assert!(value.validate(&Schema::Uuid));
+    // Resolving must not reintroduce the canonicalisation this setting avoids.
+    assert_eq!(
+        value.resolve(&Schema::Uuid)?,
+        Value::String(text.to_string())
+    );
+    Ok(())
+}
+
+/// A real `Value::Uuid` still encodes at a `uuid` position, so the setting does
+/// not take that away from a caller who builds one itself.
+#[test]
+fn explicit_uuid_value_still_encodes() -> TestResult {
+    enable();
+    let text = "6ba7b810-9dad-11d1-80b4-00c04fd430c8";
+    let value = Value::Uuid(uuid::Uuid::parse_str(text)?);
+    assert_eq!(
+        to_avro_datum(&Schema::Uuid, value)?,
+        string_datum(text.as_bytes())
+    );
+    Ok(())
+}
