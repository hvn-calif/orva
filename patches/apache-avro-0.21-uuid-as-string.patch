--- a/avro/src/util.rs
+++ b/avro/src/util.rs
@@ -48,6 +48,15 @@ pub(crate) static NON_UTF8_STRING_AS_BYTES: OnceLock<bool> = OnceLock::new();
 /// specification calls for and what every previous release did.
 pub const DEFAULT_NON_UTF8_STRING_AS_BYTES: bool = false;
 
+/// Whether a `uuid` logical type decodes as an ordinary string, preserving the
+/// bytes as written instead of parsing them into a [`Uuid`](uuid::Uuid).
+/// See [set_uuid_as_string] to change this value.
+// crate-visible for testing
+pub(crate) static UUID_AS_STRING: OnceLock<bool> = OnceLock::new();
+/// Off by default: a `uuid` is parsed and canonicalised, which is what every
+/// previous release did.
+pub const DEFAULT_UUID_AS_STRING: bool = false;
+
 pub(crate) trait MapHelper {
     fn string(&self, key: &str) -> Option<String>;
 
@@ -234,6 +243,46 @@ pub(crate) fn non_utf8_string_as_bytes() -> bool {
     *NON_UTF8_STRING_AS_BYTES.get_or_init(|| DEFAULT_NON_UTF8_STRING_AS_BYTES)
 }
 
+/// Set whether a `uuid` logical type decodes as an ordinary string rather than
+/// being parsed into a [`Uuid`](uuid::Uuid).
+///
+/// Avro defines `uuid` as a `string` logical type, and a reader is free to leave the
+/// annotation uninterpreted. avro-cpp does exactly that: it never parses or validates a
+/// `uuid`, so whatever text was written is what comes back. Parsing it here has three
+/// visible consequences that reading it as a string does not:
+///
+/// - **The bytes change.** `Uuid` re-encodes in canonical hyphenated lowercase, so
+///   `urn:uuid:` prefixes, braces, upper-case hex and unhyphenated 32-hex forms are all
+///   rewritten. A value read and written back is then not the value that arrived.
+/// - **A 16-byte string is reinterpreted.** Any `uuid` field holding exactly 16 bytes is
+///   taken as a raw `Uuid`, so an ordinary 16-character string comes back as 36
+///   characters of hex.
+/// - **Malformed text is rejected**, making data other implementations wrote unreadable.
+///
+/// With this enabled, `Schema::Uuid` decodes exactly as `Schema::String`, so it yields
+/// `Value::String`, or `Value::Bytes` when the text is not valid UTF-8 and
+/// [`set_non_utf8_string_as_bytes`] is also on. The two settings are independent and
+/// compose. `Value::String` was already accepted at a `Schema::Uuid` position by
+/// `validate` and by the encoder, so such a value stays usable and round-trips byte for
+/// byte.
+///
+/// This function only changes the setting once. On subsequent calls the value will stay
+/// the same as the first time it is called, and it is read on the first decode of a
+/// `uuid`, so it must be called before any decoding happens. It defaults to
+/// [`DEFAULT_UUID_AS_STRING`].
+///
+/// # Returns
+/// The configured value, which might be different from what the function was called
+/// with if the value was already set before. Callers that require the setting should
+/// check the returned value rather than assume it took effect.
+pub fn set_uuid_as_string(as_string: bool) -> bool {
+    *UUID_AS_STRING.get_or_init(|| as_string)
+}
+
+pub(crate) fn uuid_as_string() -> bool {
+    *UUID_AS_STRING.get_or_init(|| DEFAULT_UUID_AS_STRING)
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
