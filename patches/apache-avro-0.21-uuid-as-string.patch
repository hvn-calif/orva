             (&Value::Bytes(_), &Schema::String) if non_utf8_string_as_bytes() => None,
+            // Same reasoning for a `uuid` read as a string: with both settings on
+            // a non-UTF-8 one decodes to `Value::Bytes`, so it has to validate
+            // against the schema it came from.
+            (&Value::Bytes(_), &Schema::Uuid) if uuid_as_string() => None,
             (&Value::Bytes(_), &Schema::Decimal { .. }) => None,
             (&Value::String(_), &Schema::String) => None,
             (&Value::String(_), &Schema::Uuid) => None,
@@ -718,6 +722,12 @@ impl Value {
     fn resolve_uuid(self) -> Result<Self, Error> {
         Ok(match self {
             uuid @ Value::Uuid(_) => uuid,
+            // With the setting on a `uuid` is an ordinary string, so leave it as
+            // one: parsing here would reintroduce the canonicalisation that
+            // decoding it as a string exists to avoid. Bytes reach this only when
+            // the text was not valid UTF-8 and that setting is on too.
+            string @ Value::String(_) if uuid_as_string() => string,
+            bytes @ Value::Bytes(_) if uuid_as_string() => bytes,
             Value::String(ref string) => {
