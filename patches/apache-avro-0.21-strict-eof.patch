@@ -957,4 +930,57 @@ mod tests {
         )
         .expect_err("Value::Bytes must not encode as a string with the setting off");
     }
+
+    /// A buffer that runs out mid-datum must report the error rather than
+    /// substitute a value. Three arms used to swallow `UnexpectedEof` and
+    /// return `Value::Null`, which is not a value of `boolean`, of `string`,
+    /// or of a union whose first branch is not `null`. avro-cpp reports
+    /// "EOF reached" for every case here.
+    #[test]
+    fn truncated_input_is_an_error_not_a_fabricated_null() {
+        let cases: &[(&str, Schema, &[u8])] = &[
+            ("boolean, no bytes at all", Schema::Boolean, &[]),
+            // A length prefix of 2 with one byte behind it.
+            ("string, truncated payload", Schema::String, &[0x04, 0x61]),
+            ("bytes, truncated payload", Schema::Bytes, &[0x04, 0x61]),
+        ];
+        for (case, schema, mut input) in cases.iter().map(|(c, s, i)| (c, s, *i)) {
+            decode(schema, &mut input).expect_err(&format!("{case} must not decode"));
+        }
+    }
+
+    /// The union arm's fabrication was worse than the others, because the
+    /// value it invented was `Value::Union(0, Null)` whatever branch 0 held.
+    #[test]
+    fn truncated_union_is_an_error_even_when_branch_zero_is_null() {
+        for text in [r#"["int"]"#, r#"["null","int"]"#] {
+            let schema = Schema::parse_str(text).unwrap();
+            let mut empty: &[u8] = &[];
+            decode(&schema, &mut empty)
+                .expect_err(&format!("{text} has no branch index in an empty buffer"));
+        }
+    }
+
+    /// The shape a caller actually meets: a record whose fields are all
+    /// booleans decoded from zero bytes used to succeed with every field
+    /// `null`, so a truncated message arrived as data rather than as an error.
+    #[test]
+    fn a_record_of_booleans_does_not_decode_from_an_empty_buffer() {
+        let schema = Schema::parse_str(
+            r#"{"type":"record","name":"R","fields":[
+                 {"name":"a","type":"boolean"},{"name":"b","type":"boolean"}]}"#,
+        )
+        .unwrap();
+        let mut empty: &[u8] = &[];
+        decode(&schema, &mut empty).expect_err("an empty buffer holds no record");
+    }
+
+    /// `null` occupies zero bytes, so an empty buffer really is a whole `null`
+    /// datum. This is the one case that must keep succeeding, and it is why the
+    /// fix could not be "reject an empty buffer".
+    #[test]
+    fn null_still_decodes_from_an_empty_buffer() {
+        let mut empty: &[u8] = &[];
+        assert_eq!(decode(&Schema::Null, &mut empty).unwrap(), Value::Null);
+    }
 }
