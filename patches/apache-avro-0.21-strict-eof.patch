+        // Only `a` and `b` are on the wire; the three union fields that follow
+        // have no bytes at all. A truncated buffer is not the same thing as a
+        // writer that did not have those fields, which is what schema
+        // resolution is for, so this must fail rather than yield a record.
+        let mut truncated: &'static [u8] = &[54, 6, 102, 111, 111];
+        assert!(from_avro_datum(&schema, &mut truncated, None).is_err());
+
+        // Every field encoded, the three unions each selecting their `null`
+        // branch. The struct omits `a_nullable_boolean`, so this still covers
+        // what the test was written for: a key missing from the target struct.
+        let mut encoded: &'static [u8] = &[54, 6, 102, 111, 111, 0, 0, 0];
 
         let expected_record: TestRecord3240 = TestRecord3240 {
             a: 27i64,
