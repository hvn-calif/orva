+    /// One Avro `string`: zigzag length prefix, then the payload.
+    fn string_datum(payload: &[u8]) -> Vec<u8> {
+        let mut out = Vec::new();
+        crate::encode::encode_bytes(payload, &mut out).expect("length prefix should encode");
+        out
+    }
+
+    /// `non_utf8_string_as_bytes` is off unless a caller turns it on, so the
+    /// behaviour every previous release had is what these tests see. The
+    /// accepting side lives in `tests/non_utf8_string_as_bytes.rs`, which needs
+    /// a process of its own because the setting is set-once.
+    #[test]
+    fn test_decode_invalid_utf8_string_errors_by_default() {
+        let datum = string_datum(&[0xff, 0xfe]);
+
+        let error = decode(&Schema::String, &mut &datum[..])
+            .expect_err("a non-UTF-8 string must fail with the setting off");
+        assert!(
+            error.to_string().to_lowercase().contains("utf-8"),
+            "unexpected error: {error}"
+        );
+    }
+
+    /// Keys stay strict with the setting either way, and the error names UTF-8.
+    #[test]
+    fn test_decode_invalid_utf8_map_key_still_fails() {
+        let schema = Schema::map(Schema::Int);
+        let mut datum = vec![0x02];
+        datum.extend_from_slice(&string_datum(&[0xff]));
+        datum.push(0x02);
+        datum.push(0x00);
+
+        let error = decode(&schema, &mut &datum[..]).expect_err("a non-UTF-8 map key must fail");
+        assert!(
+            error.to_string().to_lowercase().contains("utf-8"),
+            "unexpected error: {error}"
+        );
+    }
+
+    /// With the setting off, a `Value::Bytes` is not encodable at a
+    /// `Schema::String` position either, so the pair stays symmetric.
+    #[test]
+    fn test_encode_bytes_as_string_errors_by_default() {
+        let mut buffer = Vec::new();
+
+        encode(
+            &Value::Bytes(vec![0xff, 0xfe]),
+            &Schema::String,
+            &mut buffer,
+        )
+        .expect_err("Value::Bytes must not encode as a string with the setting off");
+    }
 }
