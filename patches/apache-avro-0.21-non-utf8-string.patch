+// limitations under the License.
+
+//! The accepting side of `util::set_non_utf8_string_as_bytes`.
+//!
+//! The setting is set-once per process, so these live in their own test binary
+//! rather than beside the rejecting cases in `src/decode.rs` and `src/types.rs`.
+//! This follows `tests/serde_human_readable_true.rs`.
+
+use apache_avro::{
+    Schema, from_avro_datum, to_avro_datum, types::Value, util::set_non_utf8_string_as_bytes,
+};
+use apache_avro_test_helper::TestResult;
+
+/// Every test in this binary needs the setting on. Calling it more than once is
+/// harmless (first call wins), and the return value is the setting in effect,
+/// which is what a caller who requires it should be checking.
+fn enable() {
+    assert!(
+        set_non_utf8_string_as_bytes(true),
+        "the setting must be in effect for this test binary"
+    );
+}
+
+/// One Avro `string`: zigzag length prefix, then the payload. Only single-byte
+/// prefixes, which covers every payload below.
+fn string_datum(payload: &[u8]) -> Vec<u8> {
+    assert!(payload.len() < 64, "length would need a longer varint");
+    let mut out = vec![(payload.len() as u8) << 1];
+    out.extend_from_slice(payload);
+    out
+}
+
+fn decode(schema: &Schema, datum: &[u8]) -> Result<Value, apache_avro::Error> {
+    from_avro_datum(schema, &mut &datum[..], None)
+}
+
+#[test]
+fn invalid_utf8_string_decodes_as_bytes() -> TestResult {
+    enable();
+
+    assert_eq!(
+        decode(&Schema::String, &string_datum(&[0xff, 0xfe]))?,
+        Value::Bytes(vec![0xff, 0xfe])
+    );
+
+    Ok(())
+}
+
+/// Why `Value::Bytes` and not the bytes escaped into a `String`: under Latin-1,
+/// byte 0xFF and the two bytes 0xC3 0xBF (the legitimate encoding of U+00FF)
+/// would both give `Value::String("\u{ff}")`, leaving re-encoding no way to know
+/// which input to write back.
+#[test]
+fn invalid_utf8_does_not_collide_with_a_valid_encoding() -> TestResult {
+    enable();
+
+    let invalid = decode(&Schema::String, &string_datum(&[0xff]))?;
+    let valid = decode(&Schema::String, &string_datum(&[0xc3, 0xbf]))?;
+
+    assert_ne!(invalid, valid);
+    assert_eq!(invalid, Value::Bytes(vec![0xff]));
+    assert_eq!(valid, Value::String("\u{ff}".to_string()));
+
+    Ok(())
+}
+
+/// The point of accepting the value: it survives a re-encode unchanged.
+#[test]
+fn invalid_utf8_string_round_trips_byte_for_byte() -> TestResult {
+    enable();
+
+    let datum = string_datum(&[0xff, 0x00, 0xfe]);
+    let decoded = decode(&Schema::String, &datum)?;
+
+    assert_eq!(to_avro_datum(&Schema::String, decoded)?, datum);
+
+    Ok(())
+}
+
+/// `validate` and `resolve` accept it too, so a decoded datum can go back to the
+/// writer that produced it.
+#[test]
+fn bytes_validate_and_resolve_at_a_string_position() -> TestResult {
+    enable();
+
+    let value = Value::Bytes(vec![0xff, 0xfe]);
+    assert!(value.validate(&Schema::String));
+    assert_eq!(
+        value.resolve(&Schema::String)?,
+        Value::Bytes(vec![0xff, 0xfe])
+    );
+
+    // Valid bytes still become a `String`, the resolution this always performed.
+    assert_eq!(
+        Value::Bytes(b"abc".to_vec()).resolve(&Schema::String)?,
+        Value::String("abc".to_string())
+    );
+
+    Ok(())
+}
+
+/// Map keys stay strict even with the setting on, because `Value::Map` is keyed
+/// by `String`. The error names UTF-8 rather than claiming a wrong key type.
+#[test]
+fn invalid_utf8_map_key_still_fails() {
+    enable();
+
+    let schema = Schema::map(Schema::Int);
+    let mut datum = vec![0x02];
+    datum.extend_from_slice(&string_datum(&[0xff]));
+    datum.push(0x02);
+    datum.push(0x00);
+
+    let error = decode(&schema, &datum).expect_err("a non-UTF-8 map key must fail");
+    assert!(
+        error.to_string().to_lowercase().contains("utf-8"),
+        "unexpected error: {error}"
+    );
+}
