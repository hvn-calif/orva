+/// Whether a `string` whose wire bytes are not valid UTF-8 decodes to
+/// [`Value::Bytes`](crate::types::Value::Bytes) instead of failing.
+/// See [set_non_utf8_string_as_bytes] to change this value.
+// crate-visible for testing
+pub(crate) static NON_UTF8_STRING_AS_BYTES: OnceLock<bool> = OnceLock::new();
+/// Off by default: a non-UTF-8 `string` is an error, which is what the Avro
+/// specification calls for and what every previous release did.
+pub const DEFAULT_NON_UTF8_STRING_AS_BYTES: bool = false;
+
 pub(crate) trait MapHelper {
     fn string(&self, key: &str) -> Option<String>;
 
@@ -190,6 +199,41 @@ pub(crate) fn is_human_readable() -> bool {
     *SERDE_HUMAN_READABLE.get_or_init(|| DEFAULT_SERDE_HUMAN_READABLE)
 }
 
+/// Set whether a `string` whose wire bytes are not valid UTF-8 decodes to
+/// [`Value::Bytes`](crate::types::Value::Bytes) rather than failing.
+///
+/// Avro specifies `string` as UTF-8, but implementations exist that never enforced it:
+/// avro-cpp copies the bytes into a byte-oriented `std::string` unchecked, and Java's
+/// `Utf8` holds a raw `byte[]` that is only converted lazily. Files carrying such bytes
+/// round-trip through both, and rejecting them makes that data unreadable. Enabling this
+/// accepts them here too, keeping the bytes in a distinct variant so that re-encoding
+/// writes back exactly what was read.
+///
+/// With it enabled, `Value::Bytes` is also accepted at a `Schema::String` position by
+/// [`Value::validate`](crate::types::Value::validate), by `resolve`, and by the encoder,
+/// so a tolerated value stays usable. Note that the decoded variant then depends on the
+/// data: a single `string` field can yield `Value::String` for one record and
+/// `Value::Bytes` for the next.
+///
+/// Map keys are unaffected and stay strict, since `Value::Map` is keyed by `String`.
+///
+/// This function only changes the setting once. On subsequent calls the value will stay
+/// the same as the first time it is called, and it is read on the first decode of a
+/// `string`, so it must be called before any decoding happens. It defaults to
+/// [`DEFAULT_NON_UTF8_STRING_AS_BYTES`].
+///
+/// # Returns
+/// The configured value, which might be different from what the function was called
+/// with if the value was already set before. Callers that require the setting should
+/// check the returned value rather than assume it took effect.
+pub fn set_non_utf8_string_as_bytes(as_bytes: bool) -> bool {
+    *NON_UTF8_STRING_AS_BYTES.get_or_init(|| as_bytes)
+}
+
+pub(crate) fn non_utf8_string_as_bytes() -> bool {
+    *NON_UTF8_STRING_AS_BYTES.get_or_init(|| DEFAULT_NON_UTF8_STRING_AS_BYTES)
+}
+
