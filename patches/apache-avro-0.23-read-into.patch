+//! Compares reading an Object Container File through the `Reader` iterator,
+//! which builds a fresh `Value` tree per datum, with `Reader::read_into`,
+//! which reuses the allocations of a caller-owned `Value`.
+//!
+//! Every record has the same shape, including the union variant, which is
+//! the intended use case for `read_into` and the best case for reuse.
+//! Workloads that switch union variants between records rebuild the union's
+//! inner value each time and gain less.
+
+use apache_avro::{
+    Reader, Schema, Writer,
+    types::{Record, Value},
+};
+use criterion::{Criterion, criterion_group, criterion_main};
+use std::{hint::black_box, time::Duration};
+
+/// A shape that profits from allocation reuse: strings, bytes, and an array
+/// of records inside a nullable union.
+const RAW_SCHEMA: &str = r#"
+{
+  "type": "record",
+  "name": "Row",
+  "fields": [
+    {"name": "id", "type": "long"},
+    {"name": "name", "type": "string"},
+    {"name": "payload", "type": "bytes"},
+    {
+      "name": "metrics",
+      "type": [
+        "null",
+        {
+          "type": "array",
+          "items": {
+            "type": "record",
+            "name": "Metric",
+            "fields": [
+              {"name": "key", "type": "string"},
+              {"name": "value", "type": "long"}
+            ]
+          }
+        }
+      ]
+    }
+  ]
+}
+"#;
+
+fn make_container(schema: &Schema, n_records: usize) -> Vec<u8> {
+    let mut writer = Writer::new(schema, Vec::new()).unwrap();
+    for i in 0..n_records {
+        let metrics: Vec<Value> = (0..8)
+            .map(|m| {
+                Value::Record(vec![
+                    ("key".into(), Value::String(format!("metric-{m}"))),
+                    ("value".into(), Value::Long((i * m) as i64)),
+                ])
+            })
+            .collect();
+
+        let mut record = Record::new(schema).unwrap();
+        record.put("id", i as i64);
+        record.put("name", format!("row-{i}"));
+        record.put("payload", Value::Bytes(vec![0xAB; 64]));
+        record.put("metrics", Value::Union(1, Box::new(Value::Array(metrics))));
+        writer.append_value(record).unwrap();
+    }
+    writer.into_inner().unwrap()
+}
+
+fn read_iterator(bytes: &[u8]) -> usize {
+    let reader = Reader::new(bytes).unwrap();
+    let mut count = 0;
+    for value in reader {
+        black_box(value.unwrap());
+        count += 1;
+    }
+    count
+}
+
+fn read_into(bytes: &[u8]) -> usize {
+    let mut reader = Reader::new(bytes).unwrap();
+    let mut value = Value::Null;
+    let mut count = 0;
+    while reader.read_into(&mut value).unwrap() {
+        black_box(&value);
+        count += 1;
+    }
+    count
+}
+
+fn bench_read_into(c: &mut Criterion) {
+    let schema = Schema::parse_str(RAW_SCHEMA).unwrap();
+    let bytes = make_container(&schema, 10_000);
+
+    c.bench_function("nested schema, read 10_000 records (iterator)", |b| {
+        b.iter(|| read_iterator(&bytes));
+    });
+    c.bench_function("nested schema, read 10_000 records (read_into)", |b| {
+        b.iter(|| read_into(&bytes));
+    });
+}
+
+criterion_group!(
+    name = benches;
+    config = Criterion::default().sample_size(20).measurement_time(Duration::from_secs(10));
+    targets = bench_read_into
+);
+criterion_main!(benches);
