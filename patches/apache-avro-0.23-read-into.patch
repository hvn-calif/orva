+/// Decode a `Value` into caller-owned storage.
+///
+/// This is the counterpart to [`decode_internal`] used by `Reader::read_into`.
+/// It reuses allocations for bytes, strings, fixed values, unions, arrays,
+/// records, and enum symbols when the existing value has a compatible shape.
+/// Every other schema decodes through the owned body: scalars own no heap
+/// allocation, and maps and the allocation-owning logical types have no
+/// reusable in-place representation.
+///
+/// The per-datum allocation budget and recursion depth limit in `ctx` are
+/// charged exactly as in [`decode_internal`], by decoded size rather than by
+/// net-new allocation, so both paths accept and reject the same inputs.
+/// Reused storage keeps the largest capacity it has seen; see
+/// `Reader::read_into` for the caller-facing note.
+pub(crate) fn decode_into_internal<R: Read, S: Borrow<Schema>>(
+    schema: &Schema,
+    names: &HashMap<Name, S>,
+    enclosing_namespace: NamespaceRef,
+    reader: &mut R,
+    value: &mut Value,
+    ctx: &mut DecodeContext,
+) -> AvroResult<()> {
+    ctx.enter()?;
+    let result = decode_into_internal_body(schema, names, enclosing_namespace, reader, value, ctx);
+    ctx.leave();
+    result
+}
+
+fn decode_into_internal_body<R: Read, S: Borrow<Schema>>(
+    schema: &Schema,
+    names: &HashMap<Name, S>,
+    enclosing_namespace: NamespaceRef,
+    reader: &mut R,
+    value: &mut Value,
+    ctx: &mut DecodeContext,
+) -> AvroResult<()> {
+    match schema {
+        Schema::Bytes => {
+            let len = decode_len(reader)?;
+            ctx.debit_bytes(len)?;
+            if !matches!(value, Value::Bytes(_)) {
+                *value = Value::Bytes(Vec::new());
+            }
+            let Value::Bytes(buf) = value else {
+                unreachable!()
+            };
+            buf.resize(len, 0);
+            reader.read_exact(buf).map_err(Details::ReadBytes)?;
+        }
+        Schema::String => {
+            let len = decode_len(reader)?;
+            ctx.debit_bytes(len)?;
+            let old = std::mem::replace(value, Value::Null);
+            let mut buf = match old {
+                Value::String(string) => string.into_bytes(),
+                _ => Vec::new(),
+            };
+            buf.resize(len, 0);
+            match reader.read_exact(&mut buf) {
+                Ok(()) => {
+                    *value = Value::String(String::from_utf8(buf).map_err(Details::ConvertToUtf8)?);
+                }
+                Err(io_err) if io_err.kind() == ErrorKind::UnexpectedEof => {
+                    *value = Value::Null;
+                }
+                Err(io_err) => return Err(Details::ReadString(io_err).into()),
+            }
+        }
+        Schema::Fixed(FixedSchema { size, .. }) => {
+            ctx.debit_bytes(*size)?;
+            if !matches!(value, Value::Fixed(_, _)) {
+                *value = Value::Fixed(*size, Vec::new());
+            }
+            let Value::Fixed(current_size, buf) = value else {
+                unreachable!()
+            };
+            *current_size = *size;
+            buf.resize(*size, 0);
+            reader
+                .read_exact(buf)
+                .map_err(|e| Details::ReadFixed(e, *size))?;
+        }
+        Schema::Array(inner) => {
+            if !matches!(value, Value::Array(_)) {
+                *value = Value::Array(Vec::new());
+            }
+            let Value::Array(items) = value else {
+                unreachable!()
+            };
+            let mut decoded = 0usize;
+            loop {
+                let len = decode_seq_len(reader)?;
+                if len == 0 {
+                    break;
+                }
+
+                let total = decoded.checked_add(len).ok_or(Details::IntegerOverflow)?;
+                safe_collection_len::<Value>(total)?;
+                ctx.debit_items::<Value>(len)?;
+                // Use reserve_exact as reserve can allocate more than needed defeating the purpose
+                // of the previous check
+                if total > items.len() {
+                    items.reserve_exact(total - items.len());
+                }
+                for _ in 0..len {
+                    if decoded == items.len() {
+                        items.push(Value::Null);
+                    }
+                    decode_into_internal(
+                        &inner.items,
+                        names,
+                        enclosing_namespace,
+                        reader,
+                        &mut items[decoded],
+                        ctx,
+                    )?;
+                    decoded += 1;
+                }
+            }
+            items.truncate(decoded);
+        }
+        Schema::Union(inner) => {
+            let index = match zag_i64(reader).map_err(Error::into_details) {
+                Ok(index) => index,
+                Err(Details::ReadVariableIntegerBytes(io_err))
+                    if io_err.kind() == ErrorKind::UnexpectedEof =>
+                {
+                    if !matches!(value, Value::Union(_, _)) {
+                        *value = Value::Union(0, Box::new(Value::Null));
+                    }
+                    let Value::Union(index, inner_value) = value else {
+                        unreachable!()
+                    };
+                    *index = 0;
+                    **inner_value = Value::Null;
+                    return Ok(());
+                }
+                Err(details) => return Err(Error::new(details)),
+            };
+            let index_usize =
+                usize::try_from(index).map_err(|e| Details::ConvertI64ToUsize(e, index))?;
+            let variant = inner.get_variant(index_usize)?;
+
+            if !matches!(value, Value::Union(_, _)) {
+                *value = Value::Union(index as u32, Box::new(Value::Null));
+            }
+            let Value::Union(current_index, inner_value) = value else {
+                unreachable!()
+            };
+            decode_into_internal(
+                variant,
+                names,
+                enclosing_namespace,
+                reader,
+                inner_value,
+                ctx,
+            )?;
+            // Commit the tag only after the payload decoded, so a mid-payload
+            // error cannot leave a reused union claiming the new variant while
+            // holding the previous datum's payload.
+            *current_index = index as u32;
+        }
+        Schema::Record(RecordSchema { name, fields, .. }) => {
+            // The budget is charged by decoded size whether or not an
+            // existing allocation is reused, in the same order as in
+            // `decode_internal`, so this path accepts and rejects the same
+            // inputs and allocates no further ahead of a rejection.
+            ctx.debit_items::<(String, Value)>(fields.len())?;
+            let fully_qualified_name = name.fully_qualified_name(enclosing_namespace);
+            let namespace = fully_qualified_name.namespace();
+
+            if !matches!(value, Value::Record(_)) {
+                *value = Value::Record(Vec::new());
+            }
+            let Value::Record(items) = value else {
+                unreachable!()
+            };
+            // Reuse position-wise: a field whose name already matches keeps
+            // its string, a field value of any prior shape is decoded over in
+            // place, and only the arity is adjusted. A record arriving from a
+            // different record schema (a union alternating between variants,
+            // say) still keeps every position-compatible child allocation.
+            items.truncate(fields.len());
+            items.reserve_exact(fields.len() - items.len());
+            for (position, field) in fields.iter().enumerate() {
+                ctx.debit_bytes(field.name.len())?;
+                if position == items.len() {
+                    items.push((field.name.clone(), Value::Null));
+                } else {
+                    let (current_name, _) = &mut items[position];
+                    if current_name != &field.name {
+                        current_name.clone_from(&field.name);
+                    }
+                }
+                decode_into_internal(
+                    &field.schema,
+                    names,
+                    namespace,
+                    reader,
+                    &mut items[position].1,
+                    ctx,
+                )?;
+            }
+        }
+        Schema::Enum(EnumSchema { symbols, .. }) => {
+            let raw_index = zag_i32(reader)?;
+            let index =
+                usize::try_from(raw_index).map_err(|e| Details::ConvertI32ToUsize(e, raw_index))?;
+            let symbol = symbols.get(index).ok_or(Details::GetEnumValue {
+                index,
+                nsymbols: symbols.len(),
+            })?;
+            // Cloning the symbol allocates without consuming wire bytes, so it
+            // counts against the per-datum budget.
+            ctx.debit_bytes(symbol.len())?;
+            match value {
+                Value::Enum(current_index, current_symbol) => {
+                    *current_index = raw_index as u32;
+                    current_symbol.clone_from(symbol);
+                }
+                _ => *value = Value::Enum(raw_index as u32, symbol.clone()),
+            }
+        }
+        Schema::Ref { name } => {
+            let fully_qualified_name = name.fully_qualified_name(enclosing_namespace);
+            if let Some(resolved) = names.get(&fully_qualified_name) {
+                decode_into_internal(
+                    resolved.borrow(),
+                    names,
+                    fully_qualified_name.namespace(),
+                    reader,
+                    value,
+                    ctx,
+                )?;
+            } else {
+                return Err(
+                    Details::SchemaResolutionError(fully_qualified_name.into_owned()).into(),
+                );
+            }
+        }
+        // Everything else decodes owned, through the same body the owned path
+        // uses, because there is no allocation worth reusing: null, booleans,
+        // numbers, times, and durations own no heap allocation; a map exposes
+        // no reusable ownership of stale entries while it is being rebuilt
+        // from wire-order keys; Decimal, BigDecimal, and Uuid own
+        // allocation-bearing third-party representations without public
+        // in-place decode APIs.
+        Schema::Null
+        | Schema::Boolean
+        | Schema::Int
+        | Schema::Long
+        | Schema::Float
+        | Schema::Double
+        | Schema::Date
+        | Schema::TimeMillis
+        | Schema::TimeMicros
+        | Schema::TimestampMillis
+        | Schema::TimestampMicros
+        | Schema::TimestampNanos
+        | Schema::LocalTimestampMillis
+        | Schema::LocalTimestampMicros
+        | Schema::LocalTimestampNanos
+        | Schema::Duration(_)
+        | Schema::Map(_)
+        | Schema::Decimal(_)
+        | Schema::BigDecimal
+        | Schema::Uuid(_) => {
+            *value = decode_internal_body(schema, names, enclosing_namespace, reader, ctx)?;
+        }
+    }
+    Ok(())
+}
+
