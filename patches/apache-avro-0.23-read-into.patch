+    /// Decode into caller-owned storage the way `decode` decodes to an owned
+    /// value: references resolved from the schema, fresh per-datum context.
+    fn decode_into(schema: &Schema, input: &mut &[u8], value: &mut Value) -> crate::AvroResult<()> {
+        let rs = crate::schema::ResolvedSchema::try_from(schema)?;
+        super::decode_into_internal(
+            schema,
+            rs.get_names(),
+            None,
+            input,
+            value,
+            &mut super::DecodeContext::new(),
+        )
+    }
+
+    #[test]
+    fn test_decode_into_truncates_shrinking_array() -> TestResult {
+        let schema = Schema::array(Schema::Int).build();
+
+        let mut input: &[u8] = &[6, 2, 4, 6, 0];
+        let mut value = Value::Null;
+        decode_into(&schema, &mut input, &mut value)?;
+        assert_eq!(Array(vec![Int(1), Int(2), Int(3)]), value);
+
+        // A shorter array decoded into the same storage must not keep stale
+        // trailing elements.
+        let mut input: &[u8] = &[4, 8, 10, 0];
+        decode_into(&schema, &mut input, &mut value)?;
+        assert_eq!(Array(vec![Int(4), Int(5)]), value);
+
+        Ok(())
+    }
+
+    #[test]
+    fn test_decode_into_replaces_mismatched_variant() -> TestResult {
+        // 14 zig-zag decodes to 7.
+        let mut input: &[u8] = &[14];
+        let mut value = Value::String("stale".to_owned());
+        decode_into(&Schema::Int, &mut input, &mut value)?;
+        assert_eq!(Int(7), value);
+
+        let mut input: &[u8] = &[4, b'h', b'i'];
+        decode_into(&Schema::String, &mut input, &mut value)?;
+        assert_eq!(Value::String("hi".to_owned()), value);
+
+        Ok(())
+    }
+
+    #[test]
+    fn test_decode_into_reshapes_mismatched_record() -> TestResult {
+        let schema = Schema::parse_str(
+            r#"{
+                "type": "record",
+                "name": "test",
+                "fields": [
+                    {"name": "a", "type": "long"},
+                    {"name": "b", "type": "string"}
+                ]
+            }"#,
+        )?;
+
+        // Field names, field count, and field value shapes all differ from
+        // what the schema decodes to.
+        let mut value = Value::Record(vec![
+            ("x".to_owned(), Value::Boolean(true)),
+            ("b".to_owned(), Value::Long(1)),
+            ("z".to_owned(), Value::Null),
+        ]);
+        let mut input: &[u8] = &[54, 6, b'f', b'o', b'o'];
+        decode_into(&schema, &mut input, &mut value)?;
+        assert_eq!(
+            Value::Record(vec![
+                ("a".to_owned(), Value::Long(27)),
+                ("b".to_owned(), Value::String("foo".to_owned())),
+            ]),
+            value
+        );
+
+        Ok(())
+    }
+
+    #[test]
+    fn test_decode_into_shares_one_allocation_budget() -> TestResult {
+        use crate::util::{DEFAULT_MAX_ALLOCATION_BYTES, max_allocation_bytes};
+
+        // Mirror of avro_rs_639_test_nested_collections_share_one_allocation_budget
+        // for the into-path: the budget is charged by decoded size, so both
+        // decode paths must reject the same inputs.
+        let budget = max_allocation_bytes(DEFAULT_MAX_ALLOCATION_BYTES);
+        let inner_count = (budget / 2) / size_of::<Value>() + 1;
+
+        let inner_arrays_count = 2;
+        let mut payload = Vec::new();
+        crate::util::zig_i64(inner_arrays_count, &mut payload)?;
+        for _ in 0..inner_arrays_count {
+            payload.extend(create_block(inner_count as i64));
+        }
+        payload.push(0x00);
+
+        let schema = Schema::array(Schema::array(Schema::Null).build()).build();
+        let mut value = Value::Null;
+        let result = decode_into(&schema, &mut payload.as_slice(), &mut value);
+
+        assert!(
+            result.is_err(),
+            "nested collections must share one allocation budget, got {result:?}"
+        );
+        let details = result.unwrap_err().into_details();
+        assert!(
+            matches!(details, Details::MemoryAllocation { .. }),
+            "Expected memory allocation error, got: {details:?}"
+        );
+
+        Ok(())
+    }
+
+    #[test]
+    fn test_decode_into_recursion_depth_is_bounded() -> TestResult {
+        // Mirror of avro_rs_642_test_decode_recursion_depth_is_bounded for the
+        // into-path.
+        let schema = Schema::parse_str(
+            r#"{
+                "type": "record",
+                "name": "Node",
+                "fields": [
+                    {"name": "next", "type": ["null", "Node"]}
+                ]
+            }"#,
+        )?;
+        let recursion_depth_trigger = decode_recursion_limit() + 1;
+        let payload = vec![0x02u8; recursion_depth_trigger];
+        let mut value = Value::Null;
+        let result = decode_into(&schema, &mut payload.as_slice(), &mut value);
+        assert!(result.is_err(), "unbounded recursion must be rejected");
+
+        Ok(())
+    }
