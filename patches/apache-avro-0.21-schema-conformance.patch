+    // A duration used to render as {"type":{"type":"fixed",..},..}, which no
+    // implementation reads, so it did not survive a round trip through its own
+    // rendering. It also lost its name, because the variant carried no `fixed`
+    // to read one from; both halves are asserted here.
+    #[test]
+    fn test_duration_renders_as_an_annotated_fixed() -> TestResult {
+        let json = serde_json::to_value(Schema::duration())?;
+        assert_eq!(json["type"], "fixed");
+        assert_eq!(json["logicalType"], "duration");
+        assert_eq!(json["size"], 12);
+        assert_eq!(json["name"], "duration");
+
+        let reparsed = Schema::parse_str(&serde_json::to_string(&Schema::duration())?)?;
+        assert!(
+            matches!(reparsed, Schema::Duration(_)),
+            "a duration must re-parse as a duration, got {reparsed:?}"
+        );
+
+        // The name a schema gave survives the round trip, which is what closes
+        // the second half of the finding.
+        let named = Schema::parse_str(
+            r#"{"type":"fixed","name":"B","namespace":"ns","size":12,
+                "logicalType":"duration"}"#,
+        )?;
+        let rendered = serde_json::to_value(&named)?;
+        assert_eq!(rendered["name"], "B");
+        assert_eq!(rendered["namespace"], "ns");
+        assert_eq!(rendered["logicalType"], "duration");
+        assert_eq!(
+            Schema::parse_str(&serde_json::to_string(&named)?)?.name(),
+            named.name(),
+            "the name must survive a second round trip too"
+        );
+        Ok(())
+    }
