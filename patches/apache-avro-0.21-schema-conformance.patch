+/// The name a union branch is distinguished by, when it is a named type.
+///
+/// Two branches naming one type are two branches of the same type, so a union
+/// may not hold both a definition and a reference to it, nor two references to
+/// one name. `variant_index`'s note has recorded this gap for as long as it has
+/// existed: "this approach does not work for named types, and will have to be
+/// modified to support that. A simple solution is to also keep a mapping of the
+/// names used."
+///
+/// A reference to a name defined outside the union is a single branch and
+/// collides with nothing, so only names repeated *within* one union matter.
+fn union_branch_name(schema: &Schema) -> Option<&Name> {
+    match schema {
+        Schema::Record(record) => Some(&record.name),
+        Schema::Enum(enumeration) => Some(&enumeration.name),
+        Schema::Fixed(fixed) => Some(&fixed.name),
+        Schema::Ref { name } => Some(name),
+        // A decimal takes its name from its inner schema, exactly as it takes
+        // its underlying type from there. Without this recursion a decimal on a
+        // named `fixed` is checked by neither rule -- `union_branch_kind` skips
+        // it as named, and this would not supply the name -- so two decimals
+        // over one `fixed`, or a decimal beside the bare `fixed` it wraps, would
+        // both be accepted and then resolve to whichever branch came first.
+        Schema::Decimal(decimal) => union_branch_name(&decimal.inner),
+        // A duration is a `fixed` carrying an annotation, so its name is that
+        // `fixed`'s. Before the variant kept one, a union could hold a duration
+        // and a reference to it and neither rule saw the collision.
+        Schema::Duration(fixed) => Some(&fixed.name),
+        _ => None,
+    }
+}
+
+/// The underlying Avro type of a union branch, or `None` when the branch is a
+/// named type and so distinguished by name rather than by type.
+///
+/// A logical type is an annotation on an underlying Avro type, and the
+/// specification's uniqueness rule is about that underlying type: a union of
+/// `time-micros` and `timestamp-micros` holds two `long` branches, so it is no
+/// more legal than a union of two plain `long`s. `Schema` gives each logical
+/// type its own variant, so its discriminant cannot answer this question.
+///
+/// A decimal or a duration takes the answer from its inner schema, which is why
+/// this needs the schema and not just the kind: a decimal on `bytes` collides
+/// with plain `bytes`, while one on a `fixed` is named and collides with
+/// nothing.
+fn union_branch_kind(schema: &Schema) -> Option<SchemaKind> {
+    let kind = SchemaKind::from(schema);
+    if kind.is_named() {
+        return None;
+    }
+    Some(match kind {
+        SchemaKind::Date | SchemaKind::TimeMillis => SchemaKind::Int,
+        SchemaKind::TimeMicros
+        | SchemaKind::TimestampMillis
+        | SchemaKind::TimestampMicros
+        | SchemaKind::TimestampNanos
+        | SchemaKind::LocalTimestampMillis
+        | SchemaKind::LocalTimestampMicros
+        | SchemaKind::LocalTimestampNanos => SchemaKind::Long,
+        SchemaKind::Uuid => SchemaKind::String,
+        SchemaKind::BigDecimal => SchemaKind::Bytes,
+        SchemaKind::Decimal => match schema {
+            Schema::Decimal(decimal) => return union_branch_kind(&decimal.inner),
+            _ => SchemaKind::Decimal,
+        },
+        // A duration is a `fixed` carrying an annotation, so it is a named type
+        // and its name distinguishes it: two durations under different names are
+        // two legal branches, and a duration beside a reference to it is not.
+        // `union_branch_name` reads that name from the `fixed` the variant
+        // carries.
+        SchemaKind::Duration => return None,
+        other => other,
+    })
+}
