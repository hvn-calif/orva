+        // on a named type, and the name rule did not look inside.
+        let fixed = |size: usize| {
+            Schema::Fixed(FixedSchema {
+                name: Name::new("F").unwrap(),
+                aliases: None,
+                doc: None,
+                size,
+                default: None,
