+    // Two branches naming one type are two branches of the same type, which is
+    // the gap variant_index's note has always described. Avro C++ rejects each
+    // of these with "bad node of type union".
+    #[test]
+    fn test_union_rejects_two_branches_naming_one_type() {
+        for text in [
+            // A record beside a reference to itself.
+            r#"["int",
+                {"type":"record","name":"N0","namespace":"a.b.c",
+                 "fields":[{"name":"f","type":"long"}]},
+                "a.b.c.N0"]"#,
+            // Two references to one name.
+            r#"[{"type":"record","name":"R","fields":[
+                  {"name":"f","type":["ns.T","ns.T"]}]},
+                {"type":"record","name":"T","namespace":"ns","fields":[]}]"#,
+        ] {
+            assert!(
+                Schema::parse_str(text).is_err(),
+                "expected a duplicate-branch error: {text}"
+            );
+        }
+
+        // A duration is a named `fixed` too, so a duration beside a reference to
+        // it is two branches naming one type, and two durations under different
+        // names are legal. This is what the model change to Schema::Duration
+        // bought: neither could be told apart while the variant was nameless.
+        assert!(
+            Schema::parse_str(
+                r#"[{"type":"fixed","name":"N0","namespace":"_","size":12,
+                     "logicalType":"duration"},
+                    {"type":"long","logicalType":"timestamp-millis"},
+                    "_.N0"]"#
+            )
+            .is_err()
+        );
+        assert!(
+            Schema::parse_str(
+                r#"[{"type":"fixed","name":"A","size":12,"logicalType":"duration"},
+                    {"type":"fixed","name":"B","size":12,"logicalType":"duration"}]"#
+            )
+            .is_ok()
+        );
+
+        // A decimal takes its name from the `fixed` it wraps, so two decimals
