+/// An owning raw-datum reader with schema references resolved once.
+///
+/// [`GenericDatumReader`] avoids cloning a borrowed schema. This variant owns
+/// the writer schema instead, which makes it suitable for storing in a
+/// long-lived container reader. Its main purpose is repeated
+/// [`read_value_into`](Self::read_value_into) calls without rebuilding schema
+/// resolution state for every datum.
+pub struct OwnedGenericDatumReader {
+    resolved: ResolvedOwnedSchema,
+}
+
+impl std::fmt::Debug for OwnedGenericDatumReader {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("OwnedGenericDatumReader")
+            .field("writer_schema", &self.resolved.get_root_schema())
+            .finish()
+    }
+}
+
+impl OwnedGenericDatumReader {
+    /// Create a reader that owns `writer_schema` and resolves its named types.
+    pub fn new(writer_schema: Schema) -> AvroResult<Self> {
+        Ok(Self {
+            resolved: ResolvedOwnedSchema::new(writer_schema)?,
+        })
+    }
+
+    /// Return the writer schema.
+    pub fn writer_schema(&self) -> &Schema {
+        self.resolved.get_root_schema()
+    }
+
+    /// Read an owned Avro [`Value`].
+    pub fn read_value<R: Read>(&self, reader: &mut R) -> AvroResult<Value> {
+        let mut value = Value::Null;
+        self.read_value_into(reader, &mut value)?;
+        Ok(value)
+    }
+
+    /// Read an Avro datum into caller-owned [`Value`] storage.
+    pub fn read_value_into<R: Read>(&self, reader: &mut R, value: &mut Value) -> AvroResult<()> {
+        decode_into_internal(
+            self.resolved.get_root_schema(),
+            self.resolved.get_names(),
+            None,
+            reader,
+            value,
+        )
+    }
+}
