+
+    /// Read the next datum into caller-owned [`Value`] storage.
+    ///
+    /// Returns `Ok(true)` when a datum was read and `Ok(false)` at end of
+    /// stream. Compatible string, byte, fixed, union, array, and record
+    /// allocations are reused. This experimental API falls back to ordinary
+    /// allocation for maps, allocation-owning logical types, and reader-schema
+    /// resolution.
+    pub fn read_into(&mut self, value: &mut Value) -> AvroResult<bool> {
+        if self.errored {
+            return Ok(false);
+        }
+
+        let read_schema = if self.should_resolve_schema {
+            self.reader_schema
+        } else {
+            None
+        };
+        match self.block.read_next_into(read_schema, value) {
+            Ok(read) => Ok(read),
+            Err(error) => {
+                self.errored = true;
+                Err(error)
+            }
+        }
+    }
 }
 
