+/// The largest limit [`set_max_json_depth`] will install. The setter clamps to
+/// it and returns what it installed, so a caller asking for more can see that it
+/// did not get it.
+///
+/// A depth limit only helps while the stack can hold a document at the limit:
+/// past that point the parse aborts the process instead of returning an error,
+/// and how deep the stack reaches depends on the build. Measured on chained
+/// `{"type":"array","items":...}` documents, parsed into a [`Value`], turned into
+/// a schema, rendered and dropped: about 630 bytes of stack per level optimised
+/// and about 11.6 KiB per level unoptimised. 600 levels is therefore under
+/// 400 KiB optimised and about 7 MB unoptimised, which is why the ceiling sits
+/// here rather than higher.
+///
+/// It is also the limit avro-cpp's JSON reader uses, counting the same thing, so
+/// a document at the limit is accepted by both.
+pub const MAX_JSON_DEPTH_CEILING: usize = 600;
+
+/// The configured JSON nesting limit, or unset.
+///
+/// Unlike every other setting in this module there is no default value, and that
+/// is deliberate: while this is unset, serde_json's own limit of 128 *containers*
+/// applies, and this limit counts *values*, so any number chosen here as a
+/// default would quietly change what an existing consumer accepts. Reading it
+/// therefore must not lock a value in, which is why the reader below is
+/// [`OnceLock::get`] rather than `get_or_init`.
+static MAX_JSON_DEPTH: OnceLock<usize> = OnceLock::new();
+
 pub(crate) trait MapHelper {
     fn string(&self, key: &str) -> Option<String>;
 
@@ -283,6 +311,233 @@ pub(crate) fn uuid_as_string() -> bool {
     *UUID_AS_STRING.get_or_init(|| DEFAULT_UUID_AS_STRING)
 }
 
+/// Set the maximum JSON nesting depth accepted when parsing a schema.
+///
+/// **Unset by default, and while it is unset nothing here changes.** serde_json
+/// applies its own limit of 128 containers, no depth scan runs, and parsing
+/// behaves exactly as it did before this setting existed. Calling this switches
+/// both halves at once: serde_json's limit goes off and the scan described below
+/// goes on, so exactly one of the two limits is ever in force.
+///
+/// # What the number counts
+///
+/// Nested **values**, not brackets and not Avro type levels. A value's depth is
+/// one plus the number of arrays and objects enclosing it, so the whole
+/// document is depth 1 and the `1` in `[[1]]` is depth 3. A document is rejected
+/// when its deepest value is deeper than the limit.
+///
+/// That is one more than a bracket count whenever a scalar sits at the bottom,
+/// which in a schema document it always does: the innermost thing in a schema is
+/// a type name. So a limit of 600 accepts 599 nested containers with a scalar
+/// inside them and rejects 600.
+///
+/// A reader thinking in Avro type levels needs one more conversion, because the
+/// constructs cost different amounts:
+///
+/// | one level of | JSON levels it costs |
+/// | --- | --- |
+/// | `{"type":"array","items":X}` | 1 |
+/// | `{"type":"map","values":X}` | 1 |
+/// | a union `[X]` | 1 |
+/// | a record with one field of type `X` | 3: the record object, the `fields` array, the field object |
+///
+/// So a limit of 600 admits 599 nested arrays, and 199 nested one-field records.
+///
+/// # How it is enforced
+///
+/// The depth is measured by a single iterative pass over the input bytes, before
+/// any parsing, and a document past the limit is refused without being parsed.
+/// That order is the point: with serde_json's limit off, the parse is itself the
+/// stack risk, so measuring the depth of the parsed value would be measuring it
+/// after the danger has passed. An input nested tens of thousands of levels deep
+/// is therefore refused in constant stack.
+///
+/// # Choosing a number
+///
+/// The argument is clamped to [`MAX_JSON_DEPTH_CEILING`], because a limit above
+/// what the stack can hold converts a clean rejection into an abort, and how
+/// deep the stack reaches depends on the build. The return value is what was
+/// installed.
+///
+/// This function only changes the setting once; on subsequent calls the value
+/// stays as the first call left it. Unlike the other settings here, reading it
+/// does not install a default, so it can be set after parsing has already
+/// happened -- though a caller that wants the limit for untrusted input should
+/// set it before handling any.
+///
+/// # Returns
+/// The limit actually in effect, which differs from the argument if it was
+/// clamped or if something already set it. Callers that require a particular
+/// limit should check the returned value rather than assume it took effect.
+pub fn set_max_json_depth(max_depth: usize) -> usize {
+    *MAX_JSON_DEPTH.get_or_init(|| max_depth.min(MAX_JSON_DEPTH_CEILING))
+}
+
+fn max_json_depth() -> Option<usize> {
+    MAX_JSON_DEPTH.get().copied()
+}
+
+/// One past the last byte of the first complete JSON document in `raw`, or
+/// `None` when `raw` holds no complete document. Trailing whitespace is not
+/// included.
+///
+/// This is a structural scan and not a validator: it tracks string literals,
+/// backslash escapes and nesting, which is all that finding the boundary needs,
+/// and it takes no position on whether the document in front of it is well
+/// formed. It exists so that a caller wanting to cut input at that boundary can
+/// do so without parsing. Parsing to find the end would be the recursion a depth
+/// limit is there to prevent, so on input that has not been depth-checked yet it
+/// is the wrong order.
+pub fn json_document_end(raw: &[u8]) -> Option<usize> {
+    scan_json(raw).document_end
+}
+
+/// What one pass over JSON bytes found.
+struct JsonScan {
+    /// The deepest value in the first document, counted as one plus the number
+    /// of containers enclosing it. 0 for input with no value in it at all.
+    ///
+    /// Only the first document is measured, because that is all a parse of these
+    /// bytes recurses over: serde_json reads one value and then reports whatever
+    /// follows it as trailing characters without descending into it. An
+    /// incomplete document is measured as far as it goes, which is what bounds
+    /// input like a run of unbalanced `[`.
+    max_depth: usize,
+    /// One past the last byte of the first complete document, or `None` when
+    /// there is no complete document to find.
+    document_end: Option<usize>,
+}
+
+/// Whether `byte` ends a scalar token. serde_json's own set, so a token this
+/// scan cuts is the token serde_json cuts.
+fn ends_a_scalar(byte: u8) -> bool {
+    matches!(
+        byte,
+        b' ' | b'\n' | b'\t' | b'\r' | b'"' | b'[' | b']' | b'{' | b'}' | b',' | b':'
+    )
+}
+
+/// One past the closing quote of the string literal starting at `raw[start]`, or
+/// `None` if it never closes. A backslash escapes the byte after it, which is all
+/// this needs to know: no escape sequence can produce an unescaped quote.
+fn string_literal_end(raw: &[u8], start: usize) -> Option<usize> {
+    let mut i = start + 1;
+    while i < raw.len() {
+        match raw[i] {
+            b'\\' => i += 2,
+            b'"' => return Some(i + 1),
+            _ => i += 1,
+        }
+    }
+    None
+}
+
+/// Measures nesting depth and finds the first document's end in one iterative
+/// pass. No recursion and no allocation, so the cost is linear in `raw` and the
+/// stack use is constant however deep the input nests.
+///
+/// An object key is counted as a value here, which `readEntity` in avro-cpp does
+/// not do. It changes no maximum: a key always sits at the same depth as the
+/// value beside it, and every key in a well-formed document has one.
+fn scan_json(raw: &[u8]) -> JsonScan {
+    let mut scan = JsonScan {
+        max_depth: 0,
+        document_end: None,
+    };
+    let mut depth: usize = 0;
+    let mut i: usize = 0;
+    while i < raw.len() {
+        match raw[i] {
+            b'[' | b'{' => {
+                depth += 1;
+                scan.max_depth = scan.max_depth.max(depth);
+                i += 1;
+            }
+            b']' | b'}' => {
+                // A closer with nothing open is malformed: there is no document
+                // boundary to report, and the parse is what says why.
+                if depth == 0 {
+                    break;
+                }
+                depth -= 1;
+                i += 1;
+            }
+            b'"' => {
+                scan.max_depth = scan.max_depth.max(depth + 1);
+                match string_literal_end(raw, i) {
+                    Some(end) => i = end,
+                    // A string that never closes, so no boundary either.
+                    None => break,
+                }
+            }
+            // Nothing here is a value, so nothing here can end the document.
+            b' ' | b'\n' | b'\t' | b'\r' | b',' | b':' => {
+                i += 1;
+                continue;
+            }
+            _ => {
+                // A number, `true`, `false`, `null`, or something the parse will
+                // refuse. Either way it is one value sitting at this depth.
+                scan.max_depth = scan.max_depth.max(depth + 1);
+                while i < raw.len() && !ends_a_scalar(raw[i]) {
+                    i += 1;
+                }
+            }
+        }
+        // Back at the top level with a value behind us: the first document ends
+        // here, and the scan stops because a parse of these bytes would too.
+        if depth == 0 {
+            scan.document_end = Some(i);
+            break;
+        }
+    }
+    scan
+}
+
+/// Rejects `raw` when its JSON nests deeper than the configured limit, before
+/// anything recurses over it.
+///
+/// A no-op while the limit is unset, which is the default: serde_json's own
+/// limit is then still in force at the parse, and no scan runs.
+pub(crate) fn check_json_depth(raw: &[u8]) -> AvroResult<()> {
+    let Some(maximum) = max_json_depth() else {
+        return Ok(());
+    };
+    let depth = scan_json(raw).max_depth;
+    if depth > maximum {
+        return Err(Details::JsonDepthExceeded { depth, maximum }.into());
+    }
+    Ok(())
+}
+
+/// Parses JSON text, with serde_json's recursion limit off exactly when ours is
+/// on, so that one of the two limits always applies and never both.
+///
+/// [`check_json_depth`] must have run on the same bytes first. With the limit
+/// set, this call is the recursion that limit exists to bound.
+pub(crate) fn parse_json_str(input: &str) -> Result<Value, serde_json::Error> {
+    if max_json_depth().is_none() {
+        return serde_json::from_str(input);
+    }
+    let mut deserializer = serde_json::Deserializer::from_str(input);
+    deserializer.disable_recursion_limit();
+    let value = Value::deserialize(&mut deserializer)?;
+    deserializer.end()?;
+    Ok(value)
+}
+
+/// [`parse_json_str`] for bytes, for the container file header's `avro.schema`.
+pub(crate) fn parse_json_slice(raw: &[u8]) -> Result<Value, serde_json::Error> {
+    if max_json_depth().is_none() {
+        return serde_json::from_slice(raw);
+    }
+    let mut deserializer = serde_json::Deserializer::from_slice(raw);
+    deserializer.disable_recursion_limit();
+    let value = Value::deserialize(&mut deserializer)?;
+    deserializer.end()?;
+    Ok(value)
+}
+
