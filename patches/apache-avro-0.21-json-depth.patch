+//! `util::set_max_json_depth` at a limit the caller chose.
+//!
+//! `tests/max_json_depth.rs` runs at the ceiling, which is also what the setter
+//! clamps to, so on its own it could not tell a limit that honours its argument
+//! from one that always installs 600. This binary is that distinction; it is
+//! separate because the setting is set-once per process.
+
+use apache_avro::{Schema, error::Details, util::set_max_json_depth};
+
+/// Deliberately far below the ceiling, and small enough that both documents
+/// below fit on any stack.
+const LIMIT: usize = 8;
+
+fn enable() {
+    assert_eq!(
+        set_max_json_depth(LIMIT),
+        LIMIT,
+        "a limit under the ceiling must be installed as asked"
+    );
+}
+
+/// `levels` nested `{"type":"array","items":X}` objects around an `"int"`, whose
+/// leaf therefore sits at depth `levels + 1`.
+fn nested_arrays(levels: usize) -> String {
+    let mut json = String::new();
+    for _ in 0..levels {
+        json.push_str(r#"{"type":"array","items":"#);
+    }
+    json.push_str(r#""int""#);
+    for _ in 0..levels {
+        json.push('}');
+    }
+    json
+}
+
+#[test]
+fn a_lowered_limit_is_the_one_in_force() {
+    enable();
+
+    // Seven arrays put the leaf at depth 8, the deepest this limit admits.
+    assert!(Schema::parse_str(&nested_arrays(7)).is_ok());
+
+    let error = Schema::parse_str(&nested_arrays(8)).expect_err("depth 9 is past this limit");
+    match error.into_details() {
+        Details::JsonDepthExceeded { depth, maximum } => {
+            assert_eq!(depth, 9);
+            assert_eq!(maximum, LIMIT);
+        }
+        other => panic!("expected a depth rejection, got: {other}"),
+    }
+}
