+
+    // The depth scan. Nothing here calls `set_max_json_depth`: it is set-once per
+    // process, so setting it in this binary would decide the limit for every
+    // other test in it. The set side lives in `tests/max_json_depth.rs`.
+
+    #[test]
+    fn the_scan_counts_nested_values_and_not_brackets() {
+        // A lone scalar is one value, and so is the document that is only it.
+        assert_eq!(scan_json(br#""int""#).max_depth, 1);
+        assert_eq!(scan_json(b"42").max_depth, 1);
+        assert_eq!(scan_json(b"").max_depth, 0);
+
+        // One container with a scalar inside is two: the container, then the
+        // scalar. This is the off-by-one that makes a bracket count wrong -- both
+        // of these hold one bracket pair.
+        assert_eq!(scan_json(br#"["int"]"#).max_depth, 2);
+        assert_eq!(scan_json(b"[]").max_depth, 1);
+        assert_eq!(scan_json(b"{}").max_depth, 1);
+
+        // The maximum is over all values, so a shallow sibling does not lower it.
+        assert_eq!(scan_json(br#"[1,[2,[3]],4]"#).max_depth, 4);
+
+        // An object key sits at the same depth as the value beside it, so
+        // counting keys as values changes nothing.
+        assert_eq!(scan_json(br#"{"a":1}"#).max_depth, 2);
+        assert_eq!(scan_json(br#"{"a":{"b":1}}"#).max_depth, 3);
+
+        // The two schema shapes whose boundary the limit is pinned on. One Avro
+        // array level costs one JSON level; one one-field record costs three.
+        assert_eq!(scan_json(br#"{"type":"array","items":"int"}"#).max_depth, 2);
+        assert_eq!(
+            scan_json(br#"{"type":"record","name":"R","fields":[{"name":"f","type":"int"}]}"#)
+                .max_depth,
+            4
+        );
+    }
+
+    #[test]
+    fn the_scan_ignores_structure_inside_string_literals() {
+        // A brace in a `doc` string is not nesting, and an escaped quote does not
+        // end the string it is in.
+        // Depth 2, not 3: the object is 1, its keys and values are 2, and the
+        // empty `fields` array has nothing inside it to reach 3.
+        let doc = br#"{"type":"record","name":"R","doc":"} \" [[[","fields":[]}"#;
+        assert_eq!(scan_json(doc).max_depth, 2);
+        assert_eq!(scan_json(doc).document_end, Some(doc.len()));
+
+        // A string that never closes leaves no document boundary to report.
+        assert_eq!(scan_json(br#"["#).document_end, None);
+        assert_eq!(scan_json(br#"{"a"#).document_end, None);
+        // Nor does a trailing backslash, which escapes past the end of input.
+        assert_eq!(scan_json(br#""a\"#).document_end, None);
+    }
+
+    #[test]
+    fn the_scan_finds_the_end_of_the_first_document() {
+        // A scalar document ends with its token, whatever follows it.
+        assert_eq!(scan_json(br#""int"!"#).document_end, Some(5));
+        assert_eq!(scan_json(b"42 43").document_end, Some(2));
+        // A container document ends at the closer that balances it.
+        assert_eq!(scan_json(br#"[1,[2]] junk"#).document_end, Some(7));
+        // Leading whitespace is skipped and trailing whitespace is not included.
+        assert_eq!(scan_json(b"  [1]  ").document_end, Some(5));
+        // An unmatched closer is malformed, so there is no boundary to report.
+        assert_eq!(scan_json(b"]").document_end, None);
+    }
+
+    #[test]
+    fn the_scan_measures_an_incomplete_document_as_far_as_it_goes() {
+        // The shape that costs the least input per level, and the one an
+        // unbounded parser overflows on soonest. There is no complete document
+        // here, so the depth is what the scan walked before running out.
+        let unbalanced = vec![b'['; 5_000];
+        let scan = scan_json(&unbalanced);
+        assert_eq!(scan.max_depth, 5_000);
+        assert_eq!(scan.document_end, None);
+    }
+
+    #[test]
+    fn the_limit_is_unset_by_default() {
+        // Unset means no scan and no rejection of our own: whatever the input,
+        // `check_json_depth` passes it through and serde_json's own limit of 128
+        // containers is what decides.
+        assert_eq!(max_json_depth(), None);
+        let unbalanced = vec![b'['; 60_000];
+        assert!(check_json_depth(&unbalanced).is_ok());
+
+        // And the parse still applies serde_json's limit, so the behaviour a
+        // consumer who never calls the setter sees is unchanged.
+        let mut deep = String::new();
+        for _ in 0..200 {
+            deep.push('[');
+        }
+        assert!(parse_json_str(&deep).is_err());
+    }
+
+    #[test]
+    fn the_ceiling_is_the_limit_avro_cpp_uses() {
+        // Not an assertion about behaviour -- the boundary is pinned as documents
+        // in `tests/max_json_depth.rs`. This is here so that the literal document
+        // sizes over there have a stated source.
+        assert_eq!(MAX_JSON_DEPTH_CEILING, 600);
+    }
 }
