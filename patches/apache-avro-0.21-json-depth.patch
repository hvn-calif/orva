@@ -0,0 +1,250 @@
+// Licensed to the Apache Software Foundation (ASF) under one
+// or more contributor license agreements.  See the NOTICE file
+// distributed with this work for additional information
+// regarding copyright ownership.  The ASF licenses this file
+// to you under the Apache License, Version 2.0 (the
+// "License"); you may not use this file except in compliance
+// with the License.  You may obtain a copy of the License at
+//
+//     https://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+//! The set side of `util::set_max_json_depth`, at the ceiling.
+//!
+//! The setting is set-once per process, so these live in their own test binary
+//! rather than beside the unset cases in `src/util.rs`. This follows
+//! `tests/uuid_as_string.rs`. `tests/max_json_depth_lowered.rs` is the third
+//! binary, for a limit the caller chose rather than the ceiling.
+
+use apache_avro::{
+    Reader, Schema,
+    error::Details,
+    util::{MAX_JSON_DEPTH_CEILING, set_max_json_depth},
+};
+
+/// The limit every test in this binary runs under.
+///
+/// Asking for more than the ceiling is how the clamp gets covered: the setter
+/// installs the ceiling instead and says so in its return value, which is what a
+/// caller who requires a particular limit should be checking.
+fn enable() -> usize {
+    let installed = set_max_json_depth(usize::MAX);
+    assert_eq!(
+        installed, MAX_JSON_DEPTH_CEILING,
+        "the setter must clamp, and the clamped limit must be in effect here"
+    );
+    installed
+}
+
+/// `levels` nested `{"type":"array","items":X}` objects around an `"int"`.
+///
+/// One Avro array level is one JSON level, so the leaf sits at `levels + 1`.
+fn nested_arrays(levels: usize) -> String {
+    let mut json = String::with_capacity(levels * 25 + 8);
+    for _ in 0..levels {
+        json.push_str(r#"{"type":"array","items":"#);
+    }
+    json.push_str(r#""int""#);
+    for _ in 0..levels {
+        json.push('}');
+    }
+    json
+}
+
+/// `levels` nested one-field records around an `"int"`.
+///
+/// One Avro record level costs three JSON levels -- the record object, the
+/// `fields` array, the field object -- so the leaf sits at `3 * levels + 1`.
+/// Each record needs its own name, since two with the same fullname collide.
+fn nested_records(levels: usize) -> String {
+    let mut json = String::with_capacity(levels * 60 + 8);
+    for level in 0..levels {
+        json.push_str(r#"{"type":"record","name":"R"#);
+        json.push_str(&level.to_string());
+        json.push_str(r#"","fields":[{"name":"f","type":"#);
+    }
+    json.push_str(r#""int""#);
+    for _ in 0..levels {
+        json.push_str("}]}");
+    }
+    json
+}
+
+/// One Avro long, zigzag varint encoded: a map's entry count, or a length prefix.
+fn varint(value: i64) -> Vec<u8> {
+    let mut n = ((value << 1) ^ (value >> 63)) as u64;
+    let mut out = Vec::new();
+    loop {
+        let byte = (n & 0x7f) as u8;
+        n >>= 7;
+        if n == 0 {
+            out.push(byte);
+            return out;
+        }
+        out.push(byte | 0x80);
+    }
+}
+
+/// A container file carrying `schema_json` as its `avro.schema` header metadata,
+/// with no data blocks. Hand-built because the schema whose rejection matters
+/// cannot be parsed, so no writer can produce a file holding it.
+fn container_file(schema_json: &str) -> Vec<u8> {
+    let mut file = b"Obj\x01".to_vec();
+    // The header metadata is a map<bytes>: one block of one entry, then a zero
+    // count to end the map.
+    file.extend_from_slice(&varint(1));
+    file.extend_from_slice(&varint("avro.schema".len() as i64));
+    file.extend_from_slice(b"avro.schema");
+    file.extend_from_slice(&varint(schema_json.len() as i64));
+    file.extend_from_slice(schema_json.as_bytes());
+    file.extend_from_slice(&varint(0));
+    file.extend_from_slice(&[0u8; 16]); // the sync marker
+    file
+}
+
+/// Asserts that `error` is the depth rejection, naming `depth`, rather than
+/// anything about JSON syntax. Measuring before parsing is what buys the caller
+/// an error that says what was actually wrong with the input.
+#[track_caller]
+fn assert_is_depth_error(error: apache_avro::Error, depth: usize) {
+    match error.into_details() {
+        Details::JsonDepthExceeded {
+            depth: reported,
+            maximum,
+        } => {
+            assert_eq!(reported, depth);
+            assert_eq!(maximum, MAX_JSON_DEPTH_CEILING);
+        }
+        other => panic!("expected a depth rejection, got: {other}"),
+    }
+}
+
+#[track_caller]
+fn assert_schema_depth_rejected(json: &str, depth: usize) {
+    let error = Schema::parse_str(json).expect_err("a document past the limit must be refused");
+    assert_is_depth_error(error, depth);
+}
+
+/// Runs `body` on a thread with a stack big enough for a document at the limit.
+///
+/// The thread is not optional and the size is not arbitrary. Bisected on
+/// aarch64, one process per case, parsing and dropping a document at the limit:
+///
+/// | build | 599 arrays | 199 records |
+/// | --- | --- | --- |
+/// | unoptimised, which is what `cargo test` builds | 6.8 MiB of stack | 6.4 MiB |
+/// | optimised | 410 KiB | 851 KiB |
+///
+/// `cargo test` gives each spawned test thread 2 MiB, which runs out at 180
+/// nested arrays and 63 nested records. So the default thread cannot reach the
+/// limit in this build, and 32 MiB leaves about 4.5 times the worst case
+/// measured. Do not remove the thread and do not shrink the size.
+fn on_a_big_stack(body: impl FnOnce() + Send + 'static) {
+    std::thread::Builder::new()
+        .stack_size(32 * 1024 * 1024)
+        .spawn(body)
+        .expect("failed to spawn the deep-parse thread")
+        .join()
+        .expect("a document at the limit must parse without exhausting its stack");
+}
+
+/// The boundary, as documents rather than as a constant.
+///
+/// Two shapes, because they cost a different number of JSON levels per Avro
+/// level: an off-by-one in what the limit counts would move one pair of numbers
+/// here and not the other, which a single shape could not tell apart. The limit
+/// counts nested values, so 600 admits 599 containers with a scalar inside them.
+#[test]
+fn the_boundary_is_599_arrays_and_199_records() {
+    let limit = enable();
+    assert_eq!(
+        limit, 600,
+        "the numbers below are written out for this limit"
+    );
+
+    on_a_big_stack(move || {
+        // 599 arrays put the leaf `"int"` at depth 600. 600 arrays put it at 601.
+        assert!(Schema::parse_str(&nested_arrays(599)).is_ok());
+        assert_schema_depth_rejected(&nested_arrays(600), 601);
+
+        // Three JSON levels per record: 199 records put the leaf at 598, and 200
+        // put it at 601, so the record boundary is nowhere near the array one.
+        assert!(Schema::parse_str(&nested_records(199)).is_ok());
+        assert_schema_depth_rejected(&nested_records(200), 601);
+    });
+}
+
+/// Past the limit is a rejection that never recurses, so this test needs no
+/// stack of its own: it runs on the 2 MiB thread `cargo test` spawns, which dies
+/// at about 176 levels, and would run under the fuzzing build's 128 KiB soft
+/// limit too. Nothing here is parsed. The depths are far past the limit on
+/// purpose -- the assertion is as much that nothing overflows on the way to the
+/// error as that the error arrives.
+#[test]
+fn far_past_the_limit_is_refused_without_recursing() {
+    enable();
+
+    for levels in [601, 6_000, 60_000] {
+        assert_schema_depth_rejected(&nested_arrays(levels), levels + 1);
+    }
+
+    // A run of `[` with nothing closing it: the least input per level, and the
+    // shape an unbounded reader overflows on soonest. There is no complete
+    // document here, so the depth reported is what the scan walked.
+    assert_schema_depth_rejected(&"[".repeat(60_000), 60_000);
+}
+
+/// Every site that parses schema JSON, because a limit reaching only some of
+/// them is a limit a caller cannot rely on.
+///
+/// The container file header is the one that a check inside `Schema::parse_str`
+/// would have missed: `Reader` parses `avro.schema` itself, from bytes, without
+/// going through any of the three functions above it.
+#[test]
+fn every_parse_site_applies_the_limit() {
+    enable();
+    let too_deep = nested_arrays(600);
+    let shallow = r#"{"type":"record","name":"Shallow","fields":[]}"#;
+
+    // Schema::parse_str, via Parser::parse_str.
+    assert_schema_depth_rejected(&too_deep, 601);
+
+    // Schema::parse_list, which parses each document in its own loop.
+    let error = Schema::parse_list([&too_deep]).expect_err("parse_list must apply the limit");
+    assert_is_depth_error(error, 601);
+
+    // Schema::parse_str_with_list parses twice: the schemata, then the schema.
+    let error = Schema::parse_str_with_list(shallow, [&too_deep])
+        .expect_err("the schemata argument must apply the limit");
+    assert_is_depth_error(error, 601);
+    let error = Schema::parse_str_with_list(&too_deep, [shallow])
+        .expect_err("the schema argument must apply the limit");
+    assert_is_depth_error(error, 601);
+
+    // The container file header's avro.schema metadata.
+    let file = container_file(&too_deep);
+    let error = match Reader::new(&file[..]) {
+        Err(error) => error,
+        Ok(_) => panic!("the file header must apply the limit"),
+    };
+    assert_is_depth_error(error, 601);
+}
+
+/// The header at the limit is read rather than refused, which is the other half
+/// of the site above: a limit that rejected everything deep would pass the test
+/// before this one without being a limit at all.
+#[test]
+fn a_header_schema_at_the_limit_is_read() {
+    enable();
+
+    on_a_big_stack(|| {
+        let file = container_file(&nested_arrays(599));
+        let reader = Reader::new(&file[..]).expect("a header schema at the limit must be read");
+        assert!(matches!(reader.writer_schema(), Schema::Array(_)));
+    });
+}
